{
  "categories": [
    { "title": "🚀 Features", "labels": ["feature", "enhancement"] },
    { "title": "🐛 Bug Fixes", "labels": ["bug", "fix"] },
    { "title": "📚 Documentation", "labels": ["documentation", "docs"] },
    { "title": "🧪 Tests", "labels": ["test", "testing"] },
    { "title": "🔧 Maintenance", "labels": ["chore", "refactor", "dependencies"] }
  ],
  "template": "# Changelog - {{release}}\n\n{{CHANGELOG}}",
  "pr_template": "- {{PR_TITLE}} (#{{PR_NUMBER}})",
  "tag_filter_pattern": "^v\\d+\\.\\d+\\.\\d+$"
}
